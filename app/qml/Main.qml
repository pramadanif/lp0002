                                placeholderTextColor: root.colMuted
                                background: Rectangle {
                                    color: root.colSurface
                                    border.color: root.colBorder
                                    radius: root.radius / 2
                                }
                                onEditingFinished: if (text.trim() !== "") backend.saveHistory("execute_config_hashf", text.trim())
                            }
                            Button {
                                implicitWidth: 28
                                implicitHeight: execute_config_hashf.implicitHeight
                                text: "\u25be"
                                background: Rectangle { color: root.colSurface; border.color: root.colBorder; radius: root.radius / 2 }
                                contentItem: Text { text: parent.text; color: root.colMuted; horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter }
                                onClicked: execute_config_hashfPopup.open()
                            }
                            Popup {
                                id: execute_config_hashfPopup
                                y: parent.height; x: 0
                                width: parent.width
                                padding: 0
                                property var recentHistory: []
                                onAboutToShow: recentHistory = backend.fieldHistory("execute_config_hashf")
                                background: Rectangle { color: root.colSidebar; border.color: root.colBorder; radius: root.radius / 2 }
                                Column {
                                    width: parent.width
                                    spacing: 0
                                    topPadding: 4; bottomPadding: 4
                                    Text {
                                        text: "RECENT"
                                        visible: execute_config_hashfPopup.recentHistory.length > 0
                                        color: root.colMuted; font.pixelSize: 10; font.bold: true
                                        leftPadding: 8; topPadding: 2; bottomPadding: 2; width: parent.width
                                    }
                                    Repeater {
                                        model: execute_config_hashfPopup.recentHistory
                                        delegate: Rectangle {
                                            width: parent.width; height: 34
                                            color: _ma.containsMouse ? root.colSurface : "transparent"
                                            Text {
                                                anchors.verticalCenter: parent.verticalCenter
                                                x: 8; width: parent.width - 8
                                                text: modelData; color: root.colText; elide: Text.ElideMiddle; font.pixelSize: 13
                                            }
                                            MouseArea {
                                                id: _ma; anchors.fill: parent
                                                hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                                onClicked: { execute_config_hashf.text = modelData; execute_config_hashfPopup.close() }
                                            }
                                        }
                                    }
                                    Item {
                                        visible: execute_config_hashfPopup.recentHistory.length === 0
                                        height: 36; width: parent.width
                                        Text { anchors.centerIn: parent; text: "No recent values."; color: root.colMuted; font.pixelSize: 11 }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "proposalSeed"
                            color: root.colMuted
                            font.pixelSize: 11
                            Layout.leftMargin: 24
                        }
                        RowLayout {
                            spacing: 4
                            Layout.fillWidth: true
                            Layout.leftMargin: 24
                            Layout.rightMargin: 24
                            TextField {
                                id: execute_proposal_seedf
                                Layout.fillWidth: true
                                placeholderText: "base58 or 0x… hex"
                                color: root.colText
                                placeholderTextColor: root.colMuted
                                background: Rectangle {
                                    color: root.colSurface
                                    border.color: root.colBorder
                                    radius: root.radius / 2
                                }
                                onEditingFinished: if (text.trim() !== "") backend.saveHistory("execute_proposal_seedf", text.trim())
                            }
                            Button {
                                implicitWidth: 28
                                implicitHeight: execute_proposal_seedf.implicitHeight
                                text: "\u25be"
                                background: Rectangle { color: root.colSurface; border.color: root.colBorder; radius: root.radius / 2 }
                                contentItem: Text { text: parent.text; color: root.colMuted; horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter }
                                onClicked: execute_proposal_seedfPopup.open()
                            }
                            Popup {
                                id: execute_proposal_seedfPopup
                                y: parent.height; x: 0
                                width: parent.width
                                padding: 0
                                property var recentHistory: []
                                onAboutToShow: recentHistory = backend.fieldHistory("execute_proposal_seedf")
                                background: Rectangle { color: root.colSidebar; border.color: root.colBorder; radius: root.radius / 2 }
                                Column {
                                    width: parent.width
                                    spacing: 0
                                    topPadding: 4; bottomPadding: 4
                                    Text {
                                        text: "RECENT"
                                        visible: execute_proposal_seedfPopup.recentHistory.length > 0
                                        color: root.colMuted; font.pixelSize: 10; font.bold: true
                                        leftPadding: 8; topPadding: 2; bottomPadding: 2; width: parent.width
                                    }
                                    Repeater {
                                        model: execute_proposal_seedfPopup.recentHistory
                                        delegate: Rectangle {
                                            width: parent.width; height: 34
                                            color: _ma.containsMouse ? root.colSurface : "transparent"
                                            Text {
                                                anchors.verticalCenter: parent.verticalCenter
                                                x: 8; width: parent.width - 8
                                                text: modelData; color: root.colText; elide: Text.ElideMiddle; font.pixelSize: 13
                                            }
                                            MouseArea {
                                                id: _ma; anchors.fill: parent
                                                hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                                onClicked: { execute_proposal_seedf.text = modelData; execute_proposal_seedfPopup.close() }
                                            }
                                        }
                                    }
                                    Item {
                                        visible: execute_proposal_seedfPopup.recentHistory.length === 0
                                        height: 36; width: parent.width
                                        Text { anchors.centerIn: parent; text: "No recent values."; color: root.colMuted; font.pixelSize: 11 }
                                    }
                                }
                            }
                        }

                        Button {
                            text: backend.busy ? "\u2026" : "Execute"
                            enabled: !backend.busy
                            Layout.rightMargin: 24; Layout.alignment: Qt.AlignRight
                            onClicked: backend.execute(execute_config_hashf.text, execute_proposal_seedf.text)
                            background: Rectangle {
                                color: parent.down ? Qt.darker(root.colPrimary, 1.2) : root.colPrimary
                                radius: root.radius / 2
                                opacity: parent.enabled ? 1.0 : 0.5
                            }
                            contentItem: Text {
                                text: parent.text; color: root.colText
                                horizontalAlignment: Text.AlignHCenter
                                verticalAlignment: Text.AlignVCenter
                            }
                        }

                        Item { Layout.fillWidth: true; height: 80 }
                    }
                }
            }

            Item {
                id: pageWallet
                Rectangle { anchors.fill: parent; color: root.colSurface }
                ScrollView {
                    anchors.fill: parent; clip: true
                    contentWidth: availableWidth

                    ColumnLayout {
                        width: pageWallet.width; spacing: 12

                        Item { Layout.fillWidth: true; height: 24 }

                        Text {
                            text: "Wallet"
                            color: root.colText; font.pixelSize: 18; font.bold: true
                            Layout.leftMargin: 24
                        }

                        Text {
                            text: "CONNECTION"
                            color: root.colMuted; font.pixelSize: 10; font.bold: true; font.letterSpacing: 1
                            Layout.leftMargin: 24; Layout.topMargin: 8
                        }

                        Button {
                            text: "Check Connection"
                            Layout.leftMargin: 24
                            onClicked: backend.checkConnection()
                            background: Rectangle {
                                color: parent.down ? Qt.darker(root.colPrimary, 1.2) : root.colPrimary
                                radius: root.radius / 2
                            }
                            contentItem: Text {
                                text: parent.text; color: root.colText
                                horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter
                            }
                        }

                        Text {
                            text: backend.connectionStatus || "Not checked"
                            color: backend.connectionStatus.startsWith("\u2713") ? root.colSuccess
                                 : backend.connectionStatus.startsWith("\u2717") ? root.colError
                                 : root.colMuted
                            font.pixelSize: 13; Layout.leftMargin: 24; Layout.fillWidth: true
                            wrapMode: Text.WrapAtWordBoundaryOrAnywhere
                        }

                        Rectangle { Layout.fillWidth: true; height: 1; color: root.colBorder; Layout.topMargin: 8 }

                        Text {
                            text: "ACCOUNTS"
                            color: root.colMuted; font.pixelSize: 10; font.bold: true; font.letterSpacing: 1
                            Layout.leftMargin: 24; Layout.topMargin: 8
                        }

                        Button {
                            text: "\u21ba Refresh"
                            Layout.leftMargin: 24
                            onClicked: backend.listAccounts()
                            background: Rectangle {
                                color: parent.down ? Qt.darker(root.colPrimary, 1.2) : root.colPrimary; radius: root.radius / 2
                            }
                            contentItem: Text {
                                text: parent.text; color: root.colText
                                horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter
                            }
                        }

                        Text {
                            visible: backend.walletAccounts.length === 0
                            text: "No accounts — press Refresh."
                            color: root.colMuted; font.pixelSize: 12; Layout.leftMargin: 24
                        }

                        Repeater {
                            model: backend.walletAccounts
                            delegate: ColumnLayout {
                                Layout.fillWidth: true; spacing: 2
                                RowLayout {
                                    Layout.fillWidth: true; Layout.leftMargin: 24; Layout.rightMargin: 8
                                    Rectangle {
                                        property string _st: modelData["status"] || "unknown"
                                        width: statusLabel.implicitWidth + 10; height: 18; radius: 9
                                        color: _st === "uninitialized" ? Qt.rgba(0.6, 0.6, 0.6, 0.2)
                                             : _st === "owned"         ? Qt.rgba(0.2, 0.8, 0.4, 0.2)
                                             : _st === "foreign"       ? Qt.rgba(0.3, 0.5, 1.0, 0.2)
                                             : Qt.rgba(1.0, 0.6, 0.0, 0.2)
                                        Text {
                                            id: statusLabel
                                            anchors.centerIn: parent
                                            text: parent._st === "uninitialized" ? "free"
                                                 : parent._st === "owned"         ? "owned"
                                                 : parent._st === "foreign"       ? "other"
                                                 : "?"
                                            color: parent._st === "uninitialized" ? root.colMuted
                                                 : parent._st === "owned"         ? root.colSuccess
                                                 : parent._st === "foreign"       ? root.colPrimary
                                                 : "#f0a030"
                                            font.pixelSize: 10; font.bold: true
                                        }
                                    }
                                    Text {
                                        property string _disp: modelData["label"] || modelData["path"] || ""
                                        text: _disp
                                        visible: _disp !== ""
                                        color: modelData["label"] ? root.colPrimary : root.colMuted
                                        font.pixelSize: 11; Layout.preferredWidth: 80
                                        elide: Text.ElideRight
                                    }
                                    Text {
                                        text: modelData["id"] || ""
                                        color: root.colText; font.pixelSize: 12
                                        elide: Text.ElideMiddle; Layout.fillWidth: true
                                        MouseArea {
                                            anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                                            onClicked: walletInspectId.text = modelData["id"] || ""
                                        }
                                    }
                                    Button {
                                        implicitWidth: 28; implicitHeight: 28
                                        property bool _copied: false
                                        onClicked: { clipHelper.copyText(modelData["id"] || ""); _copied = true; _copyReset.restart() }
                                        Timer { id: _copyReset; interval: 1500; onTriggered: parent._copied = false }
                                        background: Item {}
                                        contentItem: Text {
                                            text: parent._copied ? "\u2713" : "\u29C9"
                                            color: parent._copied ? root.colSuccess : root.colMuted
                                            font.pixelSize: 14
                                            horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter
                                        }
                                    }
                                    Button {
                                        visible: (modelData["status"] || "") === "owned"
                                        implicitHeight: 22; implicitWidth: 52
                                        onClicked: backend.decodeAccount(modelData["id"] || "")
                                        background: Rectangle {
                                            color: parent.down ? Qt.darker(root.colSuccess, 1.3) : Qt.rgba(0.2, 0.8, 0.4, 0.25)
                                            radius: root.radius / 2
                                        }
                                        contentItem: Text {
                                            text: "Decode"; color: root.colSuccess; font.pixelSize: 11
                                            horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { Layout.fillWidth: true; height: 1; color: root.colBorder; Layout.topMargin: 8 }

                        Text {
                            text: "NEW ACCOUNT"
                            color: root.colMuted; font.pixelSize: 10; font.bold: true; font.letterSpacing: 1
                            Layout.leftMargin: 24; Layout.topMargin: 4
                        }

                        RowLayout {
                            Layout.fillWidth: true; Layout.leftMargin: 24; Layout.rightMargin: 24
                            TextField {
                                id: walletNewLabel
                                Layout.fillWidth: true
                                placeholderText: "Label (optional)"
                                color: root.colText; placeholderTextColor: root.colMuted
                                background: Rectangle {
                                    color: root.colBg; border.color: root.colBorder; radius: root.radius / 2
                                }
                            }
                            Button {
                                text: "+ Create"
                                onClicked: backend.createAccount(walletNewLabel.text)
                                background: Rectangle {
                                    color: parent.down ? Qt.darker(root.colPrimary, 1.2) : root.colPrimary; radius: root.radius / 2
                                }
                                contentItem: Text {
                                    text: parent.text; color: root.colText
                                    horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter
                                }
                            }
                        }

                        Rectangle { Layout.fillWidth: true; height: 1; color: root.colBorder; Layout.topMargin: 8 }

                        Text {
                            text: "INSPECT ACCOUNT"
                            color: root.colMuted; font.pixelSize: 10; font.bold: true; font.letterSpacing: 1
                            Layout.leftMargin: 24; Layout.topMargin: 8
                        }

                        RowLayout {
                            Layout.fillWidth: true; Layout.leftMargin: 24; Layout.rightMargin: 24
                            TextField {
                                id: walletInspectId
                                Layout.fillWidth: true
                                placeholderText: "Account ID (base58 or 0x\u2026 hex)"
                                color: root.colText; placeholderTextColor: root.colMuted
                                background: Rectangle {
                                    color: root.colBg; border.color: root.colBorder; radius: root.radius / 2
                                }
                            }
                            Button {
                                text: "Inspect"
                                enabled: walletInspectId.text.length > 0
                                onClicked: backend.inspectAccount(walletInspectId.text)
                                background: Rectangle {
                                    color: parent.enabled ? (parent.down ? Qt.darker(root.colPrimary, 1.2) : root.colPrimary) : root.colBorder
                                    radius: root.radius / 2
                                }
                                contentItem: Text {
                                    text: parent.text; color: root.colText
                                    horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter
                                }
                            }
                        }

                        Text {
                            visible: Object.keys(backend.walletAccountInfo).length === 0
                            text: "Enter an account ID and press Inspect."
                            color: root.colMuted; font.pixelSize: 12; Layout.leftMargin: 24
                        }

                        Repeater {
                            model: Object.keys(backend.walletAccountInfo)
                            delegate: RowLayout {
                                Layout.fillWidth: true; Layout.leftMargin: 24; Layout.rightMargin: 8
                                Text { text: modelData + ":"; color: root.colMuted; font.pixelSize: 12; Layout.preferredWidth: 140 }
                                Text {
                                    property var _v: backend.walletAccountInfo[modelData]
                                    text: _v ?? ""; color: root.colText; font.pixelSize: 12
                                    wrapMode: Text.WrapAtWordBoundaryOrAnywhere; Layout.fillWidth: true
                                }
                                Button {
                                    implicitWidth: 28; implicitHeight: 28
                                    property var _v: backend.walletAccountInfo[modelData]
                                    property bool _copied: false
                                    onClicked: { clipHelper.copyText(_v ?? ""); _copied = true; _copyReset.restart() }
                                    Timer { id: _copyReset; interval: 1500; onTriggered: parent._copied = false }
                                    background: Item {}
                                    contentItem: Text {
                                        text: parent._copied ? "\u2713" : "\u29C9"
                                        color: parent._copied ? root.colSuccess : root.colMuted
                                        font.pixelSize: 14
                                        horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter
                                    }
                                }
                            }
                        }

                        Rectangle { Layout.fillWidth: true; height: 1; color: root.colBorder; Layout.topMargin: 8 }

                        Text {
                            text: "DECODED DATA"
                            color: root.colMuted; font.pixelSize: 10; font.bold: true; font.letterSpacing: 1
                            Layout.leftMargin: 24; Layout.topMargin: 8
                        }

                        Text {
                            visible: (backend.walletDecodedAccount["type"] || "") !== ""
                            text: "Type: " + (backend.walletDecodedAccount["type"] || "")
                            color: root.colSuccess; font.pixelSize: 13; font.bold: true
                            Layout.leftMargin: 24
                        }

                        Text {
                            visible: (backend.walletDecodedAccount["status"] || "") === "uninitialized"
                            text: "Account is uninitialized (no data)."
                            color: root.colMuted; font.pixelSize: 12; Layout.leftMargin: 24
                        }

                        Text {
                            property bool _noType: Object.keys(backend.walletDecodedAccount).length > 0
                                && (backend.walletDecodedAccount["type"] === undefined || backend.walletDecodedAccount["type"] === null || backend.walletDecodedAccount["type"] === "")
                                && (backend.walletDecodedAccount["status"] || "") !== "uninitialized"
                                && (backend.walletDecodedAccount["error"] || "") === ""
                            visible: _noType
                            text: "No matching IDL type. Raw hex: " + (backend.walletDecodedAccount["raw_hex"] || "")
                            color: root.colMuted; font.pixelSize: 11; font.family: "monospace"
                            wrapMode: Text.WrapAtWordBoundaryOrAnywhere; Layout.fillWidth: true; Layout.leftMargin: 24; Layout.rightMargin: 24
                        }

                        Text {
                            visible: (backend.walletDecodedAccount["error"] || "") !== ""
                            text: backend.walletDecodedAccount["error"] || ""
                            color: root.colError; font.pixelSize: 12
                            wrapMode: Text.WrapAtWordBoundaryOrAnywhere; Layout.fillWidth: true; Layout.leftMargin: 24; Layout.rightMargin: 24
                        }

                        Text {
                            visible: Object.keys(backend.walletDecodedAccount).length === 0
                            text: "Click \"Decode\" on a program-owned account to view its data."
                            color: root.colMuted; font.pixelSize: 12; Layout.leftMargin: 24
                        }

                        Repeater {
                            model: Object.keys((backend.walletDecodedAccount["fields"] instanceof Object) ? backend.walletDecodedAccount["fields"] : {})
                            delegate: RowLayout {
                                Layout.fillWidth: true; Layout.leftMargin: 24; Layout.rightMargin: 8
                                Text { text: modelData + ":"; color: root.colMuted; font.pixelSize: 12; Layout.preferredWidth: 140 }
                                Text {
                                    property var _v: backend.walletDecodedAccount["fields"][modelData]
                                    text: _v !== undefined && _v !== null ? String(_v) : ""
                                    color: root.colText; font.pixelSize: 12; font.family: "monospace"
                                    wrapMode: Text.WrapAtWordBoundaryOrAnywhere; Layout.fillWidth: true
                                }
                                Button {
                                    implicitWidth: 28; implicitHeight: 28
                                    property var _v: backend.walletDecodedAccount["fields"][modelData]
                                    property bool _copied: false
                                    onClicked: { clipHelper.copyText(_v !== undefined ? String(_v) : ""); _copied = true; _copyReset.restart() }
                                    Timer { id: _copyReset; interval: 1500; onTriggered: parent._copied = false }
                                    background: Item {}
                                    contentItem: Text {
                                        text: parent._copied ? "\u2713" : "\u29C9"
                                        color: parent._copied ? root.colSuccess : root.colMuted
                                        font.pixelSize: 14
                                        horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter
                                    }
                                }
                            }
                        }

                        Item { Layout.fillWidth: true; height: 80 }
                    }
                }
            }

            Item {
                id: pageSettings
                Rectangle { anchors.fill: parent; color: root.colSurface }
                ScrollView {
                    anchors.fill: parent; clip: true
                    contentWidth: availableWidth

                    ColumnLayout {
                        width: pageSettings.width; spacing: 16

                        Item { Layout.fillWidth: true; height: 24 }

                        Text {
                            text: "Settings"
                            color: root.colText; font.pixelSize: 18; font.bold: true
                            Layout.leftMargin: 24
                        }

                        Text {
                            text: "Wallet Path"
                            color: root.colMuted; font.pixelSize: 11
                            Layout.leftMargin: 24
                        }
                        TextField {
                            text: backend.walletPath
                            onEditingFinished: backend.setWalletPath(text)
                            Layout.fillWidth: true
                            Layout.leftMargin: 24; Layout.rightMargin: 24
                            color: root.colText; placeholderTextColor: root.colMuted
                            background: Rectangle {
                                color: root.colSurface; border.color: root.colBorder; radius: root.radius / 2
                            }
                        }

                        Text {
                            text: "Sequencer URL"
                            color: root.colMuted; font.pixelSize: 11
                            Layout.leftMargin: 24
                        }
                        TextField {
                            text: backend.sequencerUrl
                            onEditingFinished: backend.setSequencerUrl(text)
                            Layout.fillWidth: true
                            Layout.leftMargin: 24; Layout.rightMargin: 24
                            color: root.colText; placeholderTextColor: root.colMuted
                            background: Rectangle {
                                color: root.colSurface; border.color: root.colBorder; radius: root.radius / 2
                            }
                        }

                        Text {
                            text: "Program ID (hex)"
                            color: root.colMuted; font.pixelSize: 11
                            Layout.leftMargin: 24
                        }
                        TextField {
                            text: backend.programIdHex
                            onEditingFinished: backend.setProgramIdHex(text)
                            Layout.fillWidth: true
                            Layout.leftMargin: 24; Layout.rightMargin: 24
                            color: root.colText; placeholderTextColor: root.colMuted
                            background: Rectangle {
                                color: root.colSurface; border.color: root.colBorder; radius: root.radius / 2
                            }
                        }

                        Item { Layout.fillWidth: true; height: 80 }
                    }
                }
            }

        }

        Rectangle {
            id: toast
            anchors { bottom: parent.bottom; horizontalCenter: parent.horizontalCenter; bottomMargin: 24 }
            width: Math.min(toastText.implicitWidth + 48, parent.width - 80); height: 44
            radius: root.radius
            color: root.colSurface
            opacity: 0; visible: opacity > 0

            function show(msg, col, duration) {
                toastText.text = msg
                toast.color = col
                toast.opacity = 1
                toastTimer.interval = duration || 4000
                toastTimer.restart()
            }

            Text {
                id: toastText
                anchors { fill: parent; margins: 12 }
                color: root.colText
                font.pixelSize: 13
                wrapMode: Text.WordWrap
                horizontalAlignment: Text.AlignHCenter
                verticalAlignment: Text.AlignVCenter
            }

            MouseArea {
                anchors.fill: parent
                onClicked: { toastTimer.stop(); toast.opacity = 0 }
                cursorShape: Qt.PointingHandCursor
            }

            Behavior on opacity { NumberAnimation { duration: 350 } }

            Timer {
                id: toastTimer
                onTriggered: toast.opacity = 0
            }
        }
    }
    TextEdit {
        id: clipHelper; width: 0; height: 0; opacity: 0
        function copyText(t) { clipHelper.text = t; selectAll(); copy() }
    }

}
